{
  "name": "rithik-bunnylol",
  "main": "scripts/main.js",
  "scripts": {
    "build": "npm run build:ts && npm run build:bundle && npm run build:minify",
    "build:ts": "tsc",
    "build:bundle": "rollup compiled/app.js -o bundle.js -f cjs --compact",
    "build:minify": "minify --mangle bundle.js -o scripts/main.js",
    "dev": "npm run build && node server.js",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.5.0",
    "babel-minify": "^0.5.1",
    "express": "^4.17.1",
    "rollup": "^2.26.10",
    "rollup-plugin-terser": "^5.3.1",
    "typescript": "^5.1.6"
  }
}
